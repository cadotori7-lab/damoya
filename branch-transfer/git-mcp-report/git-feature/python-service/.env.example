OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# 챗봇 사이트 안내용 Spring 프론트 주소
SITE_BASE_URL=http://localhost:8080/damoya

# Spring과 같은 Elasticsearch 서버를 사용
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_SITE_INDEX=damoya-site-pages-rag2
ELASTICSEARCH_MENTOR_INDEX=damoya-mentors
# 보안 설정을 켠 경우에만 입력
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 기본값: FastAPI(8001)에 함께 마운트된 사이트 검색 MCP 서버
MCP_SITE_SEARCH_URL=http://127.0.0.1:8001/mcp/site-search/mcp
MCP_MENTOR_RECOMMENDATION_URL=http://127.0.0.1:8001/mcp/mentor-recommendation/mcp
MCP_CLIENT_TIMEOUT_SECONDS=90

# 검색 MCP 서버를 별도 프로세스로 실행할 때 사용
MCP_SITE_SEARCH_HOST=127.0.0.1
MCP_SITE_SEARCH_PORT=8002
MCP_MENTOR_RECOMMENDATION_HOST=127.0.0.1
MCP_MENTOR_RECOMMENDATION_PORT=8003

# Git 프로젝트 AI 리포트 MCP
# 1차 버전은 공개 HTTPS GitHub 저장소만 허용
GIT_REPORT_ALLOWED_HOSTS=github.com
GIT_REPORT_GIT_EXECUTABLE=git
GIT_REPORT_CLONE_DEPTH=50
GIT_REPORT_CLONE_TIMEOUT_SECONDS=90
GIT_REPORT_COMMAND_TIMEOUT_SECONDS=30
GIT_REPORT_MAX_REPOSITORY_BYTES=262144000
GIT_REPORT_MAX_TRACKED_FILES=10000
GIT_REPORT_MAX_FILE_BYTES=524288
GIT_REPORT_MAX_FILES_PER_READ=20
GIT_REPORT_MAX_RETURNED_CHARS=400000
GIT_REPORT_WORKSPACE_TTL_SECONDS=3600
# 비워두면 Playwright가 설치한 Chromium 사용
GIT_REPORT_PLAYWRIGHT_CHANNEL=
# 운영 서버에 설치된 한글 폰트 이름을 지정할 수 있음
GIT_REPORT_PDF_FONT_FAMILY="'Pretendard', 'Noto Sans KR', 'Noto Sans CJK KR', 'Malgun Gothic', Arial, sans-serif"
