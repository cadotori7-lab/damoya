<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.soldesk.mapper.ProjectMapper">
    <resultMap id="projectResultMap" type="com.soldesk.vo.ProjectVO">
        <id column="project_id" property="projectId"/>
        <result column="owner_id" property="ownerId"/>
        <result column="title" property="title"/>
        <result column="category" property="category"/>
        <result column="summary" property="summary"/>
        <result column="capacity" property="capacity"/>
        <result column="target_grade" property="targetGrade"/>
        <result column="start_date" property="startDate"/>  
        <result column="end_date" property="endDate"/>      
        <result column="status" property="status"/>
        <result column="is_public" property="isPublic"/>
        <result column="created_at" property="createdAt"/>
        <result column="match_scope" property="matchScope"/>
        <result column="tags" property="tags"/>
        <result column="favorite_count" property="favoriteCount"/>
        <result column="view_count" property="viewCount"/>
    </resultMap>

    <!-- 프로젝트 등록 -->
    <insert id="insertProject" parameterType="com.soldesk.vo.ProjectVO" 
            useGeneratedKeys="true" keyProperty="projectId">
        insert into project (owner_id, title, category, summary, capacity, target_grade, status,  match_scope, tags, end_date)
        values (#{ownerId}, #{title}, #{category}, #{summary}, #{capacity}, #{targetGrade}, #{status}, #{matchScope}, #{tags}, #{endDate})
    </insert>

    <!-- 프로젝트 전체 목록 조회 -->
    <select id="getAllProjects" resultMap="projectResultMap">
        select * from project order by created_at desc
    </select>

    <!-- 프로잭트 상세 조회 -->
    <select id="getProjectById" parameterType="long" resultMap="projectResultMap" >
        select *
        from project 
        where project_id = #{projectId}
    </select>

    <!-- 프로젝트 모집 수정 -->
    <update id="updateProject" parameterType="com.soldesk.vo.ProjectVO">
        update project
        set title = #{title},
            category = #{category},
            match_scope = #{matchScope},
            summary = #{summary},
            capacity = #{capacity},
            target_grade = #{targetGrade},
            status = #{status},
            tags = #{tags},
            end_date = #{endDate}
        where project_id = #{projectId}
    </update>

    <!-- 프로젝트 모집 삭제 -->
    <delete id="deleteProject" parameterType="long">
        delete from project
        where project_id = #{projectId}
    </delete>

    <!-- 필터 조건에 맞는 전체 게시글 개수 구하기 -->
    <select id="getTotalCount" resultType="int" parameterType="com.soldesk.vo.ProjectVO">
        SELECT COUNT(*) 
        FROM project
        <where>
            <!-- 매칭 범위 (교내/전국) -->
            <if test="matchScope != null and matchScope != ''">
                AND match_scope = #{matchScope}
            </if>
            <!-- 탭 상태 -->
            <if test="tab != null and tab != 'all'">
                AND status = #{tab}
            </if>
            <!-- 키워드 검색 -->
            <if test="keyword != null and keyword != ''">
                AND (
                    title LIKE CONCAT('%', #{keyword}, '%')
                    OR summary LIKE CONCAT('%', #{keyword}, '%')
                    OR tags LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <!-- 카테고리 다중 선택 -->
            <if test="categoryList != null and categoryList.size() > 0">
                AND category IN
                <foreach collection="categoryList" item="category" open="(" separator="," close=")">
                    #{category}
                </foreach>
            </if>
            <!-- 대상 학년 다중 선택 -->
            <if test="gradeList != null and gradeList.size() > 0">
                <if test="!gradeList.contains('all') and !gradeList.contains('ALL') and !gradeList.contains('무관')">
                    AND (
                        target_grade = '무관' 
                        OR target_grade = 'ALL' 
                        OR target_grade = 'all'
                        OR target_grade IS NULL 
                        OR target_grade = ''
                        <foreach collection="gradeList" item="grade">
                            OR target_grade LIKE CONCAT('%', #{grade}, '%')
                        </foreach>
                    )
                </if>
            </if>
        </where>
    </select>

    <!-- 필터 조건에 맞는 게시글 리스트 조회 -->
    <select id="getProjectList" resultMap="projectResultMap" parameterType="com.soldesk.vo.ProjectVO">
        select p.*, 
        (SELECT COUNT(*) FROM comment c WHERE c.project_id = p.project_id) AS commentCount
        FROM project p
        <where>
            <!-- 매칭 범위 (교내/전국) -->
            <if test="matchScope != null and matchScope != ''">
                AND match_scope = #{matchScope}
            </if>
            <!-- 탭 상태 -->
            <if test="tab != null and tab != 'all'">
                AND status = #{tab}
            </if>
            <!-- 키워드 검색 -->
            <if test="keyword != null and keyword != ''">
                AND (
                    title LIKE CONCAT('%', #{keyword}, '%')
                    OR summary LIKE CONCAT('%', #{keyword}, '%')
                    OR tags LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <!-- 카테고리 다중 선택 -->
            <if test="categoryList != null and categoryList.size() > 0">
                AND category IN
                <foreach collection="categoryList" item="category" open="(" separator="," close=")">
                    #{category}
                </foreach>
            </if>
            <!-- 대상 학년 다중 선택 -->
            <if test="gradeList != null and gradeList.size() > 0">
                <if test="!gradeList.contains('all') and !gradeList.contains('ALL') and !gradeList.contains('무관')">
                    AND (
                        target_grade = '무관' 
                        OR target_grade = 'ALL' 
                        OR target_grade = 'all'
                        OR target_grade IS NULL 
                        OR target_grade = ''
                        <foreach collection="gradeList" item="grade">
                            OR target_grade LIKE CONCAT('%', #{grade}, '%')
                        </foreach>
                    )
                </if>
            </if>
        </where>
        
        <!-- 정렬 조건 -->
        <choose>
            <when test="sort == 'recommend'">
                ORDER BY ((favorite_count * 10) + (view_count * 5)) DESC, created_at DESC
            </when>
            <when test="sort == 'deadline'">
                ORDER BY 
                    CASE WHEN end_date &lt; CURDATE() THEN 1 ELSE 0 END ASC, 
                    end_date ASC, 
                    created_at DESC
            </when>
            <when test="sort == 'likes'">
                ORDER BY favorite_count DESC, created_at DESC
            </when>
            <otherwise>
                ORDER BY created_at DESC
            </otherwise>
        </choose>

        LIMIT #{amount} OFFSET #{offset}
    </select>

    <!-- 관심 등록 -->
    <insert id="insertFavorite">
        insert into favorite (member_id, project_id)
        values(#{memberId}, #{projectId})
    </insert>

    <!-- 관심 취소 -->
    <delete id="deleteFavorite">
        delete from favorite
        where member_id = #{memberId} and project_id = #{projectId}
    </delete>

    <!-- favorite_count  증가 -->
    <update id="increaseFavoriteCount">
        update project
        set favorite_count = favorite_count +1
        where project_id = #{projectId}
    </update>

    <!-- favorite_count  감소 -->
    <update id="decreaseFavoriteCount">
        update project
        set favorite_count = favorite_count -1
        where project_id = #{projectId}
    </update>

    <!-- 로그인한 유저가 좋아요 눌렀는지 확인 -->
    <select id="checkFavorite">
        select count(*)
        from favorite
        where member_id = #{memberId} and project_id = #{projectId}
    </select>

    <!-- 사용자가 관심 등록한 프로젝트 총 개수 -->
    <select id="getFavoriteTotalCount" resultType="int" parameterType="long">
        SELECT COUNT(*) 
        FROM favorite f 
        WHERE f.member_id = #{memberId}
    </select>

    <!-- 사용자가 관심 등록한 프로젝트 페이징 조회 -->
    <select id="getFavoriteProjectsPaged" resultMap="projectResultMap">
        SELECT p.* 
        FROM project p 
        INNER JOIN favorite f ON p.project_id = f.project_id 
        WHERE f.member_id = #{memberId} 
        ORDER BY f.project_id DESC 
        LIMIT #{amount} OFFSET #{offset}
    </select>

    <!-- 내가 관심등록한 게시글 보기 -->
    <select id="getFavoriteProjectsByMemberId" resultMap="projectResultMap" parameterType="long">
        SELECT p.* 
        FROM project p 
        INNER JOIN favorite f ON p.project_id = f.project_id 
        WHERE f.member_id = #{memberId} 
        ORDER BY p.project_id DESC
    </select>

    <!-- 게시글 조회수 불러오기 -->
    <update id="increaseViewCount">
        update project
        set view_count = view_count + 1
        where project_id = #{projectId}
    </update>

</mapper>